# SEC requires a descriptive User-Agent with contact info: "Your Name your@email.com"
SEC_USER_AGENT=
# Only needed for the LLM extractor (the lexicon extractor needs no key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Max characters of each document sent to the LLM (about 4 characters per token)
MAX_CHARS=60000
